{
  "version": 1,
  "name": "setup-steps",
  "targets": ["copilot"],
  "env": {
    "copilotSetupSteps": {
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 90,
      "permissions": { "contents": "read" },
      "steps": [
        { "name": "Checkout code", "uses": "actions/checkout@v5" },
        { "name": "Set up Bun", "uses": "oven-sh/setup-bun@v2", "with": { "bun-version": "1.2.20" } },
        { "name": "Install dependencies", "run": "bun install --frozen-lockfile" }
      ]
    }
  }
}
