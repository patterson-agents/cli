[
  {
    "path": "opencode.json",
    "format": "json",
    "mode": "merge",
    "patch": [
      {
        "keyPath": [
          "$schema"
        ],
        "value": "https://opencode.ai/config.json"
      },
      {
        "keyPath": [
          "skills",
          "paths"
        ],
        "value": [
          ".agents/skills"
        ]
      },
      {
        "keyPath": [
          "permission"
        ],
        "value": {
          "edit": "ask",
          "bash": {
            "bun test *": "allow",
            "*": "ask"
          },
          "webfetch": "deny"
        }
      }
    ]
  }
]
